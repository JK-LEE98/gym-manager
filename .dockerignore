# 이미지에 넣지 않을 것.
# .gitignore와 목적이 다르다. 여기 없는 파일은 전부 빌드 컨텍스트로 전송된다.

# 호스트에서 빌드된 결과물. 컨테이너 안에서 새로 빌드하므로 가져가면 안 된다
# (macOS ARM에서 만든 네이티브 모듈이 리눅스 이미지에 섞이는 것을 방지)
node_modules
dist
build

# 시크릿. 절대 이미지에 포함하지 않는다. 런타임에 환경변수로 주입한다
.env
.env.*
!.env.example

# 버전 관리·CI
.git
.gitignore
.github

# 개발 환경 전용
.vscode
.idea
docker-compose.yml
Dockerfile
.dockerignore

# 테스트·문서
test
coverage
*.md
!README.md

# 로그·임시
*.log
.DS_Store
