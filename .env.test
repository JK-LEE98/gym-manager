# E2E 테스트 전용 설정.
#
# 실제 시크릿이 아니므로 git에 커밋한다. CI도 이 파일을 그대로 사용한다.
# (CI의 PostgreSQL 서비스 컨테이너도 5433으로 매핑해 로컬과 동일하게 맞췄다)

# DB — 개발 DB(5432)와 분리된 테스트 전용 컨테이너
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=gym
DB_PASSWORD=gym1234
DB_DATABASE=gym_manager_test

# JWT — 테스트용 고정값
#
# 32자 이상이어야 한다. 검증에 테스트 예외를 두면
# 그 예외가 진짜 구멍이 되는 통로가 되므로 길이만 맞췄다.
# 셋은 서로 달라야 한다 (ADR-013)
JWT_ACCESS_SECRET=test-access-secret-for-e2e-only-do-not-use
JWT_REFRESH_SECRET=test-refresh-secret-for-e2e-only-do-not-use
JWT_QR_SECRET=test-qr-secret-for-e2e-only-do-not-use-either
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Seed
SEED_ADMIN_LOGIN_ID=superadmin
SEED_ADMIN_PASSWORD=admin1234!
SEED_ADMIN_NAME=테스트 운영자

# App
PORT=3000
NODE_ENV=test
