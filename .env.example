# 앱 기동 시 형식이 검증된다. 틀리면 뜨지 않는다.
# 규칙은 src/common/config/env.validation.ts 참고

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gym
DB_PASSWORD=
DB_DATABASE=gym_manager

# JWT
#
# 셋 다 32자 이상이고 서로 달라야 한다.
# HS256은 HMAC-SHA256이라 해시 출력이 32바이트다. 그보다 짧으면 그만큼 약해진다.
#
#   openssl rand -base64 48
#
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# QR 출석 전용. Access와 분리해야 type 검증이 유일한 방어선이 되지 않는다 (ADR-013)
JWT_QR_SECRET=

# 30s · 15m · 1h 형식
JWT_ACCESS_EXPIRES_IN=1h
# 일 단위만 허용한다. TokenService가 'd'를 떼고 숫자로 바꾸기 때문이다
JWT_REFRESH_EXPIRES_IN=30d

# Seed (최초 SUPER_ADMIN) — 시드 스크립트에서만 쓴다. 앱 기동에는 필요 없다
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# CORS — 브라우저에서 이 API를 부를 수 있는 오리진. 콤마로 구분한다.
# 생략하면 http://localhost:5173 (Vite dev 서버 기본 포트)
CORS_ORIGINS=http://localhost:5173

# App
PORT=3000
# development | test | production
NODE_ENV=development
