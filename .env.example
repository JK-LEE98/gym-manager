# DB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gym
DB_PASSWORD=
DB_DATABASE=gym_manager

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# QR 출석 전용. Access와 분리해야 type 검증이 유일한 방어선이 되지 않는다 (ADR-013)
JWT_QR_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Seed (최초 SUPER_ADMIN)
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# App
PORT=3000
NODE_ENV=development
